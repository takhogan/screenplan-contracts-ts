{
  "name": "@screenplan/contracts",
  "version": "0.1.0",
  "description": "ScreenPlan shared TypeScript types and AJV validators (Script, ScriptAction, ScriptActionLog, queue entries) generated from packages/screenplan-contracts/schemas.",
  "license": "ISC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rm -rf dist src/_generated",
    "codegen": "node scripts/codegen.mjs",
    "prebuild": "npm run codegen",
    "build": "tsc -p tsconfig.json",
    "validate": "node ./test/validate-examples.mjs",
    "test": "npm run build && npm run validate",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@screenplan/contracts-schemas": "git+https://github.com/takhogan/screenplan-contracts.git",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.4.0"
  }
}
